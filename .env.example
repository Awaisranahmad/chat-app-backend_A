# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# Every secret lives here, never in code.

# MongoDB connection string (local or Atlas).
MONGO_URI=mongodb://localhost:27017/chat-app

# Port the server listens on.
PORT=3000

# NODE_ENV: development | test | production.
# In production JWT_SECRET is REQUIRED — the server refuses to start
# without it.
NODE_ENV=development

# Secret used to sign login (JWT) tokens. Generate a long random one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid (e.g. 7d, 24h, 60m).
JWT_EXPIRES_IN=7d

# bcrypt cost factor for password hashing (10 is the usual default;
# higher is slower and stronger).
BCRYPT_ROUNDS=10

# Browser origins allowed to call the API (comma-separated). Add your
# frontend's origin here when you deploy it, e.g.:
# CORS_ORIGIN=https://chat-app-frontend.onrender.com
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limiting: window in milliseconds, max requests per IP per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
# Stricter limit for register/login (brute-force protection).
AUTH_RATE_LIMIT_MAX=10
